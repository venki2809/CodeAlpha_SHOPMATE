# Local-first demo. Keep this file as reference; .env is OPTIONAL.
PORT=5000
# auto = try embedded MongoDB and fall back to local JSON when unavailable
# json = immediately use persistent JSON file (no Mongo download)
# mongo = require embedded MongoDB (first startup downloads roughly 600 MB)
DATA_MODE=auto
# To use your own Atlas server one day, set MONGODB_URI (optional)
# MONGODB_URI=mongodb+srv://YOUR_REAL_CLUSTER/shopmate
# Optional: provide your own long secret; otherwise a local secret is generated and saved.
# JWT_SECRET=replace-with-a-long-secret-with-at-least-32-characters
CLIENT_URL=http://localhost:5173
# Optional override for embedded MongoDB download version
MONGOMS_VERSION=7.0.24
